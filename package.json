{
  "name": "@dz-web/o-orange",
  "version": "4.1.1",
  "description": "A javascript utility library",
  "main": "./dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "keywords": [
    "utils",
    "util",
    "javascript",
    "frontend"
  ],
  "scripts": {
    "prepare": "dumi setup",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --coverage && coveralls < coverage/lcov.info",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:badges": "npm run test:coverage  &&  jest-coverage-badges",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "coverage": "cat ./coverage/lcov.info | coveralls",
    "build": "father build",
    "dev": "dumi dev",
    "docs:build": "dumi build",
    "docs:dep": "PUBLIC_PATH='/ld/o-orange/' yarn docs:build && npx dz-ud /ld/o-orange",
    "docs:deploy": "PUBLIC_PATH='/o-orange/' yarn docs:build && gh-pages -d docs/dist"
  },
  "repository": {
    "type": "git",
    "url": ""
  },
  "author": "moonlit",
  "license": "MIT",
  "bugs": {
    "url": ""
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "homepage": "",
  "devDependencies": {
    "coveralls": "^3.1.0",
    "dumi": "^2.2.17",
    "father": "^4.1.7",
    "jest": "^29.5.0",
    "jest-coverage-badges": "^1.1.2",
    "tslint": "^6.1.3",
    "typescript": "^4.1.2"
  },
  "dependencies": {
    "big.js": "^6.2.1"
  },
  "jest": {
    "coverageReporters": [
      "json-summary",
      "text",
      "lcov"
    ]
  }
}
